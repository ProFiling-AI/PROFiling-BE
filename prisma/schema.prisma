generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                    @id @default(autoincrement())
  name                  String                 @db.VarChar(36)
  school                School
  major                 String?
  sub_major             String?
  grade                 Int?
  email                 String                 @unique @db.VarChar(255)
  password              String
  agreed_privacy        Boolean                @default(false)
  agreed_at             DateTime?
  created_at            DateTime               @default(now())
  ended_at              DateTime?
  ended_reason          String?
  notifications         Notification[]
  recordings            Recording[]
  schedules             Schedule[]
  subjects              Subject[]
  quiz                  Quiz[]
  answer                Answer[]
  trash                 Trash[]
  plans                 UserPlanStatus[]
  user_created_subjects UserProfessorSubject[]
  user_version_infos    UserVersionInfo[]
}

model EmailVerification {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  verificationCode String
  codeExpires      DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  verified         Boolean  @default(false)
}

model Subject {
  id               Int                    @id @default(autoincrement())
  user_id          Int
  subject_name     String
  is_favorite      Boolean                @default(false)
  created_at       DateTime               @default(now())
  deleted_at       DateTime?
  recordings       Recording[]
  user             User                   @relation(fields: [user_id], references: [id])
  created_subjects UserProfessorSubject[]
}

model Quiz {
  id            Int       @id @default(autoincrement())
  user_id       Int
  recording_id  Int
  title         String
  type          QuizType
  total_score   Int
  attempt       Int       @default(1)
  created_at    DateTime  @default(now()) 

  question      Question[]
  user          User       @relation(fields: [user_id], references: [id])
  recording     Recording  @relation(fields: [recording_id], references: [id])
}

model Question {
  id           Int        @id @default(autoincrement())
  quiz_id      Int
  stem         String
  explanation  String
  score        Int        @default(10)   
  blank_answer String?                   

  quiz         Quiz       @relation(fields: [quiz_id], references: [id])
  choices      QuizChoice[]
  answers      Answer[]

  @@index([quiz_id])
}

model QuizChoice {
  id          Int      @id @default(autoincrement())
  question_id Int
  content     String   
  is_correct  Boolean  

  answer      Answer[]
  question    Question @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([question_id])
}

model Answer {
  id            Int       @id @default(autoincrement())
  question_id   Int
  user_id       Int
  choice_id     Int?
  text_answer   String?

  is_correct    Boolean   @default(false) 
  submitted_at  DateTime  @default(now())

  question      Question  @relation(fields: [question_id], references: [id], onDelete: Cascade)
  choice        QuizChoice? @relation(fields: [choice_id], references: [id])
  user          User      @relation(fields: [user_id], references: [id])

  @@index([question_id])
  @@index([user_id])
  @@map("answer")
}

model UserProfessorSubject {
  id                  Int             @id @default(autoincrement())
  subject_id          Int
  user_id             Int
  professor_course_id Int
  created_at          DateTime        @default(now())
  deleted_at          DateTime?
  professor_course    ProfessorCourse @relation(fields: [professor_course_id], references: [id])
  subject             Subject         @relation(fields: [subject_id], references: [id])
  user                User            @relation(fields: [user_id], references: [id])

  @@unique([user_id, subject_id])
}

model ProfessorCourse {
  id            Int                     @id @default(autoincrement())
  professor_id  Int
  subject_name  String
  school        School
  created_at    DateTime                @default(now())
  professor     Professor               @relation(fields: [professor_id], references: [id])
  exams         ProfessorCourseExam[]
  reviews       ProfessorCourseReview[]
  user_subjects UserProfessorSubject[]
}

model Professor {
  id                Int               @id @default(autoincrement())
  name              String
  gender            Gender
  department        String
  subject_name      String
  school            School
  created_at        DateTime          @default(now())
  professor_courses ProfessorCourse[]
}

model ProfessorCourseReview {
  id                  Int             @id @default(autoincrement())
  professor_course_id Int
  content             String
  rating              Int             @default(0)
  created_at          DateTime        @default(now())
  professor_course    ProfessorCourse @relation(fields: [professor_course_id], references: [id])
}

model ProfessorCourseExam {
  id                  Int             @id @default(autoincrement())
  professor_course_id Int
  content             String
  created_at          DateTime        @default(now())
  professor_course    ProfessorCourse @relation(fields: [professor_course_id], references: [id])
}

model Recording {
  id            Int            @id @default(autoincrement())
  user_id       Int
  subject_id    Int
  title         String         @default("제목을 입력하세요")
  started_at    DateTime       @default(now())
  ended_at      DateTime
  deleted_at    DateTime?
  audio_path    String
  quiz          Quiz[]
  bookmarks     Bookmark[]
  highlights    Highlight[]
  memos         Memo[]
  notifications Notification[]
  subject       Subject        @relation(fields: [subject_id], references: [id])
  user          User           @relation(fields: [user_id], references: [id])
  schedules     Schedule[]
}

model Bookmark {
  id           Int       @id @default(autoincrement())
  recording_id Int
  timestamp    Float
  created_at   DateTime  @default(now())
  recording    Recording @relation(fields: [recording_id], references: [id])
}

model Memo {
  id           Int       @id @default(autoincrement())
  recording_id Int
  title        String    @default("제목을 입력하세요")
  content      String
  created_at   DateTime  @default(now())
  updated_at   DateTime?
  deleted_at   DateTime?
  recording    Recording @relation(fields: [recording_id], references: [id])
}

model Highlight {
  id           Int       @id @default(autoincrement())
  recording_id Int
  section      String
  color        Color     @default(YELLOW)
  recording    Recording @relation(fields: [recording_id], references: [id])
}

model Schedule {
  id           Int       @id @default(autoincrement())
  user_id      Int
  recording_id Int
  title        String
  start        DateTime  @default(now())
  end          DateTime  @default(now())
  allDay       Boolean   @default(false)
  location     String?
  memo         String?
  alarm_option AlertType @default(NONE)
  created_at   DateTime  @default(now())
  updated_at   DateTime?
  deleted_at   DateTime?
  recording    Recording @relation(fields: [recording_id], references: [id])
  user         User      @relation(fields: [user_id], references: [id])
}

model Notification {
  id           Int              @id @default(autoincrement())
  user_id      Int
  event_id     Int
  recording_id Int
  type         NotificationType
  message      String?
  created_at   DateTime         @default(now())
  read         Boolean          @default(false)
  deleted_at   DateTime?
  recording    Recording        @relation(fields: [recording_id], references: [id])
  user         User             @relation(fields: [user_id], references: [id])
}

model Trash {
  id            Int      @id @default(autoincrement())
  user_id       Int
  data_type     String
  original_id   Int
  deleted_at    DateTime @default(now())
  original_data Json
  is_restored   Boolean  @default(false)
  user          User     @relation(fields: [user_id], references: [id])
}

model UserVersionInfo {
  id              Int      @id @default(autoincrement())
  user_id         Int
  latest          String
  min_required    String
  released_at     DateTime
  is_force_update Boolean  @default(false)
  user            User     @relation(fields: [user_id], references: [id])
}

model Plan {
  id            Int              @id @default(autoincrement())
  name          String           @default("Free")
  monthly_quota Int
  price         Int
  description   String
  is_active     Boolean          @default(true)
  user_plans    UserPlanStatus[]
}

model UserPlanStatus {
  user_id          Int
  plan_id          Int
  usage_this_month Int       @default(0)
  reset_at         DateTime?
  subscribed_at    DateTime  @default(now())
  is_active        Boolean   @default(false)
  payment_info     String?
  plan             Plan      @relation(fields: [plan_id], references: [id])
  user             User      @relation(fields: [user_id], references: [id])

  @@id([user_id, plan_id])
}

enum Gender {
  MALE
  FEMALE
}

enum QuizType {
  OXQUIZ
  SPACEQUIZ
}

enum Color {
  YELLOW
  GREEN
  BLUE
  PINK
}

enum AlertType {
  NONE
  AT_TIME
  BEFORE_30_MIN
  BEFORE_1_DAY
  BEFORE_3_DAYS
}

enum NotificationType {
  REVIEW
  CALENDAR
}

